<Window x:Class="Tvoice.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tvoice.Windows.Controls"
        Title="Tvoice"
        Icon="Assets/Tvoice.ico"
        Width="1020"
        Height="720"
        MinWidth="880"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource WindowBrush}">
        <!-- Login -->
        <Grid Visibility="{Binding IsLoginVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid MaxWidth="850" Margin="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="390" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="18,0,70,0">
                    <controls:BrandMark Width="72" Height="72" HorizontalAlignment="Left" />
                    <TextBlock Text="Tvoice" FontSize="44" FontWeight="SemiBold" Margin="0,22,0,10" />
                    <TextBlock Text="Один спокойный рабочий стол для звонков, сообщений и видеовстреч."
                               FontSize="18" LineHeight="27" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                        <Border Style="{StaticResource Card}" Padding="12,7" Margin="0,0,8,0">
                            <TextBlock Text="SIP" Style="{StaticResource CaptionText}" />
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12,7" Margin="0,0,8,0">
                            <TextBlock Text="Чаты" Style="{StaticResource CaptionText}" />
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12,7">
                            <TextBlock Text="Видео" Style="{StaticResource CaptionText}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="30" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Вход" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Используйте данные вашей учётной записи FreePBX"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,7,0,26" />

                        <TextBlock Text="SIP-номер" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,7" />
                        <TextBox Text="{Binding SipNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,17" />
                        <TextBlock Text="Пароль" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,7" />
                        <PasswordBox PasswordChanged="PasswordBox_OnPasswordChanged" Margin="0,0,0,22" />
                        <Button Content="Продолжить" Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,17,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Application shell -->
        <Grid Visibility="{Binding IsShellVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TabControl SelectedIndex="{Binding SelectedTabIndex}" TabStripPlacement="Left">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource SidebarBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="78" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                                        <controls:BrandMark Width="38" Height="38" />
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tvoice" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="Workspace" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                        <TextBlock Text="РАЗДЕЛЫ" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SubtleTextBrush}" Margin="22,0,0,8" />
                                        <TabPanel IsItemsHost="True" />
                                    </StackPanel>

                                    <Border Grid.Row="2" Margin="10,10,10,14" Padding="10"
                                            Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="8"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <TextBlock Text="{Binding SipNumber}" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="Подключено" FontSize="10"
                                                           Foreground="{DynamicResource SuccessBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource WindowBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid Margin="24,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" />
                                            <TextBlock Text="{Binding StatusMessage}" Margin="9,0,0,0"
                                                       FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="↻  Обновить" Command="{Binding RefreshCommand}"
                                                Style="{StaticResource GhostButton}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Background="{DynamicResource WindowBrush}">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Contacts -->
                <TabItem Header="Контакты" Tag="○">
                    <Grid Margin="28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Контакты" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Абоненты вашей сети FreePBX" Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                            <ListBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="3,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="11"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <TextBlock Text="{Binding DisplayName, StringFormat={}{0}}" FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding SipNumber}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" />
                                                <TextBlock Text="Доступен" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                           Margin="7,0,5,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Видео" Command="{Binding VideoCallContactCommand}" Margin="0,0,8,0" />
                            <Button Content="Позвонить" Command="{Binding CallContactCommand}" Margin="0,0,8,0" />
                            <Button Content="Открыть чат" Command="{Binding StartChatCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Calls -->
                <TabItem Header="Звонки" Tag="↗">
                    <Grid Margin="28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Звонки" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="SIP-аудио и защищённые видеовызовы"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Padding="26"
                                    Visibility="{Binding IsDialerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Width="280" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Новый вызов" Style="{StaticResource SectionTitle}"
                                               HorizontalAlignment="Center" />
                                    <TextBox Text="{Binding DialNumber, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="25" TextAlignment="Center" Margin="0,17,0,14"
                                             Background="Transparent" BorderThickness="0,0,0,1" />
                                    <UniformGrid Columns="3" Rows="4" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource DialButton}" Content="1" Command="{Binding DialDigitCommand}" CommandParameter="1" />
                                        <Button Style="{StaticResource DialButton}" Content="2" Command="{Binding DialDigitCommand}" CommandParameter="2" />
                                        <Button Style="{StaticResource DialButton}" Content="3" Command="{Binding DialDigitCommand}" CommandParameter="3" />
                                        <Button Style="{StaticResource DialButton}" Content="4" Command="{Binding DialDigitCommand}" CommandParameter="4" />
                                        <Button Style="{StaticResource DialButton}" Content="5" Command="{Binding DialDigitCommand}" CommandParameter="5" />
                                        <Button Style="{StaticResource DialButton}" Content="6" Command="{Binding DialDigitCommand}" CommandParameter="6" />
                                        <Button Style="{StaticResource DialButton}" Content="7" Command="{Binding DialDigitCommand}" CommandParameter="7" />
                                        <Button Style="{StaticResource DialButton}" Content="8" Command="{Binding DialDigitCommand}" CommandParameter="8" />
                                        <Button Style="{StaticResource DialButton}" Content="9" Command="{Binding DialDigitCommand}" CommandParameter="9" />
                                        <Button Style="{StaticResource DialButton}" Content="*" Command="{Binding DialDigitCommand}" CommandParameter="*" />
                                        <Button Style="{StaticResource DialButton}" Content="0" Command="{Binding DialDigitCommand}" CommandParameter="0" />
                                        <Button Style="{StaticResource DialButton}" Content="#" Command="{Binding DialDigitCommand}" CommandParameter="#" />
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Margin="6,17,6,0">
                                        <Button Content="Аудио" Command="{Binding StartCallCommand}"
                                                Style="{StaticResource SuccessButton}" Margin="0,0,5,0" />
                                        <Button Content="Видео" Command="{Binding StartVideoCallCommand}"
                                                Style="{StaticResource PrimaryButton}" Margin="5,0,0,0" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,10">
                                        <TextBlock Text="Недавние" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="История на этом устройстве" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding CallHistory}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding PeerNumber}" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0">
                                                            <Run Text="{Binding Direction, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Kind, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StartedAt, StringFormat={}{0:dd.MM HH:mm}}"
                                                                   Style="{StaticResource CaptionText}" />
                                                        <TextBlock Text="{Binding Duration}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Chats -->
                <TabItem Header="Чаты" Tag="◇">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource SidebarBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="8,7,8,14">
                                    <TextBlock Text="Чаты" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Последние диалоги" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource SurfaceBrush}">
                                                    <TextBlock Text="{Binding Peer.DisplayName}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                    <TextBlock Text="{Binding Peer.DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding LastMessage.Body}" Style="{StaticResource CaptionText}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActivePeerName}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Tvoice · защищённый диалог" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" Padding="18,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border MaxWidth="560" Padding="13,10" Margin="0,3" HorizontalAlignment="Left"
                                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="11">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Sender.DisplayName}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="14" Margin="0,3,0,0" />
                                                <Button Content="{Binding Attachment.Name, StringFormat=📎 {0}}"
                                                        Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Attachment}"
                                                        Visibility="{Binding Attachment, Converter={StaticResource NullToVisibilityConverter}}"
                                                        HorizontalAlignment="Left" Margin="0,7,0,3" Padding="9,4" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}}" Style="{StaticResource CaptionText}" />
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource MessageStatusConverter}}" FontSize="11" Margin="4,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="delivered">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="read">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Padding="16,12" Background="{DynamicResource SurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="＋" Command="{Binding AttachFileCommand}" Style="{StaticResource IconButton}"
                                            Margin="0,0,10,0" ToolTip="Отправить фото или файл (до 20 МБ)" />
                                    <TextBox Grid.Column="1" Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MaxHeight="100" TextWrapping="Wrap"
                                             Background="{DynamicResource WindowBrush}" />
                                    <Button Grid.Column="2" Content="Отправить" Command="{Binding SendMessageCommand}"
                                            Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Account -->
                <TabItem Header="Аккаунт" Tag="◉">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="Аккаунт" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Профиль и состояние подключений" Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,5,0,20" />

                            <Border Style="{StaticResource Card}" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="{Binding SipNumber}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SipNumber, StringFormat=SIP {0}}" Style="{StaticResource CaptionText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="12"
                                            Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock Text="●  Подключено" FontSize="11" Foreground="{DynamicResource SuccessBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="Подключения" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="16,13">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="FreePBX" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="185.177.2.115 · UDP" Style="{StaticResource CaptionText}" />
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                                    <Grid Margin="16,13">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Чат-сервер" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Подключён" Foreground="{DynamicResource SuccessBrush}" FontSize="12" />
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                                    <Grid Margin="16,13">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Видеосервер" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="LiveKit" Style="{StaticResource CaptionText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Приложение" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                            <Border Style="{StaticResource Card}" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Системная тема" FontWeight="SemiBold" />
                                        <TextBlock Text="Оформление меняется вместе с Windows" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Tvoice 1.1.0" Style="{StaticResource CaptionText}" />
                                </Grid>
                            </Border>

                            <Button Content="Выйти из аккаунта" Command="{Binding LogoutCommand}"
                                    Foreground="{DynamicResource DangerBrush}" Background="{DynamicResource DangerSoftBrush}"
                                    BorderBrush="{DynamicResource DangerSoftBrush}" HorizontalAlignment="Left" Margin="0,22,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Compact floating audio call -->
            <Border Width="350" Margin="0,0,22,22" Padding="18"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Visibility="{Binding IsCallPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="16" Effect="{StaticResource FloatingShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="☎" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" FontSize="17" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{Binding CallPeer}" FontSize="16" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding CallStatus}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="  ·  " Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding CallDuration}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Принять" Command="{Binding AcceptCallCommand}"
                                Visibility="{Binding IsIncomingCall, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource SuccessButton}" Padding="12,5" />
                    </Grid>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,0">
                        <Button Content="{Binding MuteButtonText}" Command="{Binding ToggleMuteCommand}" Margin="0,0,5,0" />
                        <Button Content="{Binding HoldButtonText}" Command="{Binding ToggleHoldCommand}" Margin="5,0" />
                        <Button Content="Завершить" Command="{Binding HangupCommand}"
                                Style="{StaticResource DangerButton}" Margin="5,0,0,0" />
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Incoming video modal -->
            <Border Width="390" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsIncomingVideoVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="16" Effect="{StaticResource FloatingShadow}">
                <StackPanel>
                    <Border Width="58" Height="58" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="▣" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Входящий видеозвонок" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding IncomingVideoPeer}" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,7,0,22" />
                    <UniformGrid Columns="2">
                        <Button Content="Отклонить" Command="{Binding RejectVideoCallCommand}"
                                Style="{StaticResource DangerButton}" Margin="0,0,6,0" />
                        <Button Content="Принять" Command="{Binding AnswerVideoCallCommand}"
                                Style="{StaticResource SuccessButton}" Margin="6,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
