{
    email {$ACME_EMAIL}
}

{$CHAT_HOST} {
    encode zstd gzip
    @conference_invite path /conference/join/*
    redir @conference_invite https://tvoice-web-pwa.sugdnet11.chatgpt.site{uri} temporary
    reverse_proxy chat:8080
}

{$PBX_HOST} {
    encode zstd gzip
    reverse_proxy http://10.10.10.2:80
}

# TLS/WSS signalling terminates on the chat VM. LiveKit media remains on the
# dedicated VM via TCP 7881 and UDP 7882-7885.
{$VIDEO_HOST} {
    reverse_proxy http://10.10.10.8:7880
}

http://185.177.2.115 {
    redir https://{$CHAT_HOST}{uri} permanent
}
